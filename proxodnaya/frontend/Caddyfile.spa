:80 {
	root * /srv
	encode zstd gzip
	# service worker и index.html не кэшируются: новая сборка подхватывается сразу
	@nocache path /sw.js /index.html /*.webmanifest
	header @nocache Cache-Control "no-cache"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
