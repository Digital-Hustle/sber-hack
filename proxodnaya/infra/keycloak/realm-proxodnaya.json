{
  "realm": "proxodnaya",
  "displayName": "Проходная",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru",
    "en"
  ],
  "defaultLocale": "ru",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "CODE_TO_TOKEN_ERROR",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_PASSWORD",
    "CLIENT_LOGIN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Администратор"
      },
      {
        "name": "MANAGER",
        "description": "Руководитель"
      },
      {
        "name": "SECURITY_OFFICER",
        "description": "Офицер безопасности"
      },
      {
        "name": "GUARD",
        "description": "Охранник на киоске"
      },
      {
        "name": "SVC_PEOPLE",
        "description": "Сервис people"
      },
      {
        "name": "SVC_ACCESS",
        "description": "Сервис access"
      },
      {
        "name": "SVC_SHIFT",
        "description": "Сервис shift"
      },
      {
        "name": "SVC_ASSISTANT",
        "description": "Сервис assistant"
      }
    ]
  },
  "clients": [
    {
      "clientId": "gate-admin",
      "name": "Кабинет",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "https://${PUBLIC_HOST}/admin/*"
      ],
      "webOrigins": [
        "https://${PUBLIC_HOST}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${PUBLIC_HOST}/admin/*"
      },
      "protocolMappers": [
        {
          "name": "aud-people",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "people",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "aud-access",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "access",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "aud-shift",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "shift",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "aud-assistant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "assistant",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
