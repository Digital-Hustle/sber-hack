# Скопируйте в .env. Никогда не коммитьте .env
POSTGRES_SUPERUSER_PASSWORD=change-me
# по пользователю БД на сервис
DB_PEOPLE_PASSWORD=change-me
DB_ACCESS_PASSWORD=change-me
DB_FACE_PASSWORD=change-me
DB_SHIFT_PASSWORD=change-me
DB_ASSISTANT_PASSWORD=change-me
DB_NOTIFY_PASSWORD=change-me
# RabbitMQ (пользователь на сервис)
RABBIT_ADMIN_PASSWORD=change-me
RABBIT_PEOPLE_PASSWORD=change-me
RABBIT_ACCESS_PASSWORD=change-me
RABBIT_FACE_PASSWORD=change-me
RABBIT_SHIFT_PASSWORD=change-me
RABBIT_ASSISTANT_PASSWORD=change-me
RABBIT_NOTIFY_PASSWORD=change-me
PASS_TOKEN_HMAC_SECRET=change-me-32-bytes-min
PASS_TOKEN_TTL_SECONDS=30
FACE_MATCH_THRESHOLD=0.363
PUBLIC_HOST=localhost
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
IMAGE_TAG=latest
# Keycloak
KC_HOSTNAME=auth.localhost
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
KC_DB_PASSWORD=change-me
KC_PROVISIONER_SECRET=change-me
# service accounts (client credentials) для межсервисных вызовов
KC_SVC_ACCESS_SECRET=change-me
KC_SVC_ASSISTANT_SECRET=change-me
KC_SVC_NOTIFY_SECRET=change-me
KC_DEMO_ADMIN_PASSWORD=change-me-12chars
# Крипто
BIOMETRY_KEY=base64-32-bytes
DEVICE_TOKEN_SIGNING_KEY=base64-pkcs8-ec-p256
# GigaChat (только если LLM_PROVIDER=gigachat)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
