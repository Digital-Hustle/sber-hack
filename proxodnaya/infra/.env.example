# Скопируйте в .env и заполните (scripts/gen-env.sh генерирует случайные значения). Никогда не коммитьте .env.
# Формат для новых переменных: NAME=...  (+ compose, CI и документация в том же PR)

# --- PostgreSQL (одна БД и роль на сервис) ---
POSTGRES_SUPERUSER_PASSWORD=...
PEOPLE_DB_PASSWORD=...
ACCESS_DB_PASSWORD=...
FACE_DB_PASSWORD=...
SHIFT_DB_PASSWORD=...
ASSISTANT_DB_PASSWORD=...
LIQUIBASE_CONTEXTS=prod

# --- Kafka (KRaft, один брокер, внутри сети без порта наружу) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLUSTER_ID=...

# --- Keycloak (OIDC) ---
KC_HOSTNAME=...
KC_BOOTSTRAP_ADMIN_USERNAME=...
KC_BOOTSTRAP_ADMIN_PASSWORD=...
KC_DB_PASSWORD=...
OIDC_ISSUER_URI=...
# service accounts (client credentials) для межсервисных вызовов
KC_SVC_PEOPLE_SECRET=...
KC_SVC_ACCESS_SECRET=...
KC_SVC_SHIFT_SECRET=...
KC_SVC_ASSISTANT_SECRET=...
KC_DEMO_ADMIN_PASSWORD=...

# --- Пропуска и устройства ---
PASS_QR_WINDOW_SECONDS=30
PASS_QR_CLOCK_SKEW_SECONDS=90
DEVICE_TOKEN_SIGNING_KEY=...
OFFLINE_SNAPSHOT_SIGNING_KEY=...
OFFLINE_SNAPSHOT_TTL_HOURS=12

# --- Лицо (face, Python) ---
BIOMETRY_KEY=...
FACE_MATCH_THRESHOLD=0.363
FACE_LIVENESS_THRESHOLD=0.8

# --- LLM (assistant) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
LLM_API_KEY=...
LLM_TIMEOUT_SECONDS=30
GIGACHAT_AUTH_KEY=...
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Прочее ---
PUBLIC_HOST=...
IMAGE_TAG=latest
OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# access: проход (значения по умолчанию — в services/access/src/main/resources/application.yml)
FACE_URL=http://face:8000
PEOPLE_URL=http://people:8081
SHIFT_URL=http://shift:8083
DEPS_TIMEOUT=1500ms
QR_WINDOW_TOLERANCE=90s
REPEAT_SCAN_COOLDOWN=30s
PRESENCE_TTL=16h
CHALLENGE_TTL=10s
SITE_ZONE=Europe/Moscow

# people: инвайты рабочих
INVITE_PEPPER=...   # ≥ 32 символа, openssl rand -base64 48
INVITE_TTL=72h
PUBLIC_URL=https://...   # адрес фронта, куда ведёт ссылка-инвайт
