# Скопируйте в .env и заполните (scripts/gen-env.sh генерирует случайные значения). Никогда не коммитьте .env.
# Формат для новых переменных: NAME=...  (+ compose, CI и документация в том же PR)

# --- PostgreSQL (одна БД и роль на сервис) ---
POSTGRES_SUPERUSER_PASSWORD=...
PEOPLE_DB_PASSWORD=...
ACCESS_DB_PASSWORD=...
FACE_DB_PASSWORD=...
SHIFT_DB_PASSWORD=...
ASSISTANT_DB_PASSWORD=...
LIQUIBASE_CONTEXTS=prod

# --- Kafka (KRaft, один брокер, внутри сети без порта наружу) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLUSTER_ID=...

# --- Keycloak (OIDC) ---
KC_HOSTNAME=...
KC_BOOTSTRAP_ADMIN_USERNAME=...
KC_BOOTSTRAP_ADMIN_PASSWORD=...
KC_DB_PASSWORD=...
OIDC_ISSUER_URI=...
# service accounts (client credentials) для межсервисных вызовов
KC_SVC_PEOPLE_SECRET=...
KC_SVC_ACCESS_SECRET=...
KC_SVC_SHIFT_SECRET=...
KC_SVC_ASSISTANT_SECRET=...
KC_DEMO_ADMIN_PASSWORD=...

# --- Пропуска и устройства ---
PASS_QR_WINDOW_SECONDS=30
PASS_QR_CLOCK_SKEW_SECONDS=90
DEVICE_TOKEN_SIGNING_KEY=...
OFFLINE_SNAPSHOT_SIGNING_KEY=...
OFFLINE_SNAPSHOT_TTL_HOURS=12

# --- Лицо (face, Python) ---
# AES-256 ключ эталонов, base64 от 32 байт (openssl rand -base64 32)
BIOMETRY_KEY=...
# остальные пороги и их значения по умолчанию — services/face/src/face/core/config.py
FACE_MATCH_THRESHOLD=0.363
FACE_CONSISTENCY_THRESHOLD=0.30
FACE_MIN_SIZE=80
FACE_YAW_MIN=0.12
FACE_PITCH_DELTA=0.12
# кадры киоска зеркальные (превью камеры) — инвертирует направление поворота
FACE_MIRRORED=false
FACE_AUDIENCE=face

# --- LLM (assistant) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
LLM_API_KEY=...
LLM_TIMEOUT_SECONDS=30
GIGACHAT_AUTH_KEY=...
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Прочее ---
PUBLIC_HOST=...
IMAGE_TAG=latest
OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# access: проход (значения по умолчанию — в services/access/src/main/resources/application.yml)
FACE_URL=http://face:8090
# people → face (enroll считает эмбеддинги, дольше verify)
FACE_TIMEOUT=5s
PEOPLE_URL=http://people:8081
SHIFT_URL=http://shift:8083
DEPS_TIMEOUT=1500ms
QR_WINDOW_TOLERANCE=90s
REPEAT_SCAN_COOLDOWN=30s
PRESENCE_TTL=16h
CHALLENGE_TTL=10s
SITE_ZONE=Europe/Moscow

# shift: смены и интервалы (PRESENCE_TTL и SITE_ZONE — общие с access)
SHIFT_EARLY_ENTRY=60m
AUTO_CLOSE_AFTER=2h

# people: инвайты рабочих
INVITE_PEPPER=...   # ≥ 32 символа, openssl rand -base64 48
INVITE_TTL=72h
PUBLIC_URL=https://...   # адрес фронта, куда ведёт ссылка-инвайт

# gateway: единственная точка входа (Caddy → gateway:8080), management :8079 наружу не публикуется
# OIDC_JWKS_URI по умолчанию = ${OIDC_ISSUER_URI}/protocol/openid-connect/certs (внутри сети — http://keycloak:8080/...)
OIDC_JWKS_URI=http://keycloak:8080/realms/proxodnaya/protocol/openid-connect/certs
ACCESS_URL=http://access:8082
ASSISTANT_URL=http://assistant:8084
# origin кабинета и PWA через запятую
CORS_ORIGINS=https://...
MAX_BODY=5MB
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_WINDOW=1m
UPSTREAM_TIMEOUT=30s
