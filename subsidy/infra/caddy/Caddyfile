# Единая точка входа: фронт, Keycloak под /auth, API через gateway.
{
	admin 127.0.0.1:2019
}

{$PUBLIC_HOST} {
	tls internal
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	# Внутренние эндпоинты снаружи закрыты (rules.md §2)
	@internal path /internal/* /*/internal/* /ocr/*
	respond @internal 404

	@api path /package/* /docproc/* /rules/* /assistant/* /actuator/health
	handle @api {
		reverse_proxy gateway:8080 {
			flush_interval -1
		}
	}

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
