{
  "mcpServers": {
    "shadcn": {
      "command": "sh",
      "args": ["-c", "cd proxodnaya/frontend 2>/dev/null; exec npx -y shadcn@latest mcp"]
    },
    "magicui": {
      "command": "npx",
      "args": ["-y", "@magicuidesign/mcp@latest"]
    },
    "21st": {
      "url": "https://21st.dev/api/mcp",
      "headers": { "x-api-key": "${env:API_KEY_21ST}" }
    }
  }
}
