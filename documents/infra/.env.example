# Скопируйте в .env и заполните (scripts/gen-env.sh генерирует случайные значения). Никогда не коммитьте .env.
# Формат для новых переменных: NAME=...  (+ compose, CI и документация в том же PR)

# --- PostgreSQL (одна БД и роль на сервис) ---
POSTGRES_SUPERUSER_PASSWORD=...
INTAKE_DB_PASSWORD=...
DOCPROC_DB_PASSWORD=...
REVIEW_DB_PASSWORD=...
LIQUIBASE_CONTEXTS=prod

# --- Kafka (KRaft, один брокер, внутри сети без порта наружу) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLUSTER_ID=...

# --- Keycloak (OIDC, realm documents) ---
KC_BOOTSTRAP_ADMIN_USERNAME=...
KC_BOOTSTRAP_ADMIN_PASSWORD=...
KC_DB_PASSWORD=...
OIDC_ISSUER_URI=...
KC_SVC_INTAKE_SECRET=...
KC_SVC_DOCPROC_SECRET=...
KC_SVC_REVIEW_SECRET=...
KC_DEMO_OPERATOR_PASSWORD=...
KC_DEMO_SENIOR_PASSWORD=...
KC_DEMO_AUDITOR_PASSWORD=...

# --- Приём файлов (intake) ---
# AES-256-GCM, base64 32 байта (gen-env.sh)
FILES_ENCRYPTION_KEY=...
UPLOAD_MAX_MB=20
UPLOAD_MAX_PAGES=20
UPLOAD_MAX_FILES=40
IMAGE_MIN_PX=600
# перец для хэша ключа заявки и кода возврата
ACCESS_KEY_PEPPER=...
RESUME_CODE_MAX_ATTEMPTS=5
# адрес фронта, куда ведёт ссылка-ключ
PUBLIC_URL=https://localhost

# --- Разбор (docproc, ocr) ---
INTAKE_URL=http://intake:8081
DOCPROC_URL=http://docproc:8082
REVIEW_URL=http://review:8083
OCR_URL=http://ocr:8000
DOCPROC_WORKERS=4
JOB_LEASE=2m
JOB_MAX_ATTEMPTS=5
CLASSIFY_MIN_CONFIDENCE=0.6
FIELD_REVIEW_THRESHOLD=0.8
VISION_FALLBACK_ENABLED=false
OCR_LANGS=rus+eng
OCR_MIN_CONFIDENCE=55

# --- LLM (libs/llm, используется docproc) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:8b
LLM_VISION_MODEL=qwen2.5vl:7b
# для openai: json_schema | json_object | none
LLM_JSON_MODE=json_schema
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=2
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Прочее ---
PUBLIC_HOST=...
# Общий сервер с edge-прокси (DEPLOY.md): CADDY_SCHEME=http://, HTTP_BIND=127.0.0.1:8180, HTTPS_BIND=127.0.0.1:8543
CADDY_SCHEME=
HTTP_BIND=80
HTTPS_BIND=443
# Локально образы собираются compose; на сервере documents-deploy ставит ghcr.io/<org>/documents
IMAGE_REGISTRY=documents
IMAGE_TAG=latest
OTLP_ENDPOINT=http://jaeger:4318/v1/traces
SITE_ZONE=Europe/Moscow


# gateway: лимиты частоты по IP (создание заявок, загрузки, вход по коду)
RATE_LIMIT_ENABLED=true
